# rmu-api-strategic: local development outside Docker (`pnpm start:dev`). Copy to .env.
# Requires the infrastructure started from rmu-platform (`make up-infra`). From the host:
# Mongo localhost:27017, Keycloak http://localhost:8090/sso, Kafka localhost:9093. Port 9092 is the
# in-network listener and advertises rmu-kafka-broker, which the host cannot resolve.

# --- Server ---------------------------------------------------------------------------------------
PORT=3002
LOG_LEVEL=debug

# --- MongoDB --------------------------------------------------------------------------------------
RMU_MONGO_STRATEGIC_URI=mongodb://admin:admin@localhost:27017/rmu-strategic?authSource=admin

# --- Keycloak -------------------------------------------------------------------------------------
RMU_IAM_JWK_URI=http://localhost:8090/sso/realms/rmu/protocol/openid-connect/certs
RMU_IAM_ISSUER_URI=http://localhost/sso/realms/rmu
RMU_IAM_AUDIENCE=rmu-api
RMU_IAM_TOKEN_URI=http://localhost:8090/sso/realms/rmu/protocol/openid-connect/token
RMU_IAM_CLIENT_ID=rmu-client
RMU_IAM_CLIENT_SECRET=changeit

# --- Calls to other APIs ---------------------------------------------------------------------------
# No answer within this time is a 504 upstream-timeout (default 10000).
RMU_HTTP_TIMEOUT_MS=10000

# --- Kafka ----------------------------------------------------------------------------------------
RMU_KAFKA_BROKERS=localhost:9093
RMU_KAFKA_CLIENT_ID=rmu-api-strategic
RMU_KAFKA_CONSUMER_GROUP_ID=rmu-api-strategic-consumer
RMU_KAFKA_DEFAULT_PARTITIONS=1

# --- Other APIs -----------------------------------------------------------------------------------
RMU_API_CORE_URI=http://localhost:3001/v1
RMU_API_ITEMS_URI=http://localhost:3006/v1
RMU_API_SPELLS_URI=http://localhost:3009/v1

# --- HTTP (optional) --------------------------------------------------------------------------------
# No origins: CORS stays off. RMU_THROTTLE_LIMIT=0 turns the request limit off.
RMU_CORS_ORIGINS=
RMU_THROTTLE_LIMIT=300
RMU_THROTTLE_TTL_MS=60000
RMU_TRUST_PROXY=loopback, linklocal, uniquelocal

# --- Export and import (optional) -------------------------------------------------------------------
# Body limit of the import routes, in bytes (default 5 MB)
RMU_STRATEGIC_IMPORT_MAX_BYTES=5242880

# House rules of the economy (workspace spec 023): percent paid on a sale, percent of the average cost of crafting
# materials, and sale percent of an intact, damaged and broken item.
RMU_STRATEGIC_SALE_PERCENT=50
RMU_STRATEGIC_MATERIALS_PERCENT=50
RMU_STRATEGIC_CONDITION_PERCENTS=100,50,10
